<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ICE LAB | Premium Ice Delivery Gaborone Botswana</title>
    <meta name="description"
        content="ICE LAB premium ice delivery in Gaborone Botswana for events, bars, restaurants and bulk orders.">
    <meta name="keywords" content="ice delivery Gaborone, ice supplier Botswana, cube ice Botswana">
    <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800&family=Poppins:wght@300;400;600&display=swap"
        rel="stylesheet">

    <style>
        :root {
            --bg: #06131C;
            --bg-alt: #0A1B26;
            --ink: #EAFBFF;
            --ink-dim: #9FC6D2;
            --accent: #00D9FF;
            --accent-soft: #67D8FF;
            --line: rgba(0, 217, 255, .18);
        }

        * {
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--ink);
            font-family: Poppins, sans-serif;
            line-height: 1.6;
        }

        h1,
        h2,
        h3 {
            font-family: Orbitron, sans-serif;
            margin: 0;
        }

        /* NAVIGATION */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 32px;
            background: rgba(6, 19, 28, .75);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--line);
            transition: transform .4s ease;
        }

        .logo {
            font-family: Orbitron;
            font-size: 24px;
            font-weight: 800;
            color: var(--accent);
            letter-spacing: 1px;
        }

        nav .links a {
            color: var(--ink);
            text-decoration: none;
            margin-left: 26px;
            font-size: 13px;
            letter-spacing: .5px;
            text-transform: uppercase;
            opacity: .85;
            transition: .25s;
        }

        nav .links a:hover {
            color: var(--accent);
            opacity: 1;
        }

        /* HERO */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 120px 20px 60px;
            background:
                radial-gradient(circle at 50% 20%, rgba(0, 217, 255, .18), transparent 55%),
                linear-gradient(180deg, #06131C 0%, #081722 100%);
        }

        .hero h1 {
            font-size: clamp(32px, 5vw, 48px);
            max-width: 820px;
            color: var(--accent);
            letter-spacing: 1px;
        }

        .hero p {
            font-size: 17px;
            max-width: 560px;
            color: var(--ink-dim);
            margin-top: 18px;
        }

        .stock {
            margin: 24px 0 8px;
            padding: 9px 22px;
            border-radius: 30px;
            font-size: 13px;
            background: rgba(0, 217, 255, .1);
            border: 1px solid var(--accent);
            color: var(--accent-soft);
            letter-spacing: .5px;
        }

        .hero-actions {
            margin-top: 10px;
        }

        .btn {
            padding: 13px 28px;
            margin: 6px;
            border-radius: 8px;
            border: 1px solid var(--accent);
            background: transparent;
            color: var(--accent);
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            font-size: 14px;
            letter-spacing: .4px;
            transition: .25s;
        }

        .btn:hover {
            background: var(--accent);
            color: var(--bg);
            box-shadow: 0 0 20px rgba(0, 217, 255, .35);
        }

        .btn.solid {
            background: var(--accent);
            color: var(--bg);
        }

        .btn.solid:hover {
            background: var(--accent-soft);
        }

        /* SECTIONS */
        section {
            max-width: 1080px;
            margin: auto;
            padding: 90px 22px;
        }

        section.alt {
            background: var(--bg-alt);
            max-width: none;
        }

        section.alt>* {
            max-width: 1080px;
            margin-left: auto;
            margin-right: auto;
        }

        .section-title {
            color: var(--accent);
            text-align: center;
            font-size: 28px;
            letter-spacing: 1px;
            margin-bottom: 12px;
        }

        .section-sub {
            text-align: center;
            color: var(--ink-dim);
            font-size: 14px;
            margin-bottom: 44px;
        }

        /* CARDS */
        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 18px;
        }

        .card {
            background: rgba(255, 255, 255, .03);
            padding: 26px;
            border-radius: 12px;
            border: 1px solid var(--line);
            transition: .25s;
        }

        .card:hover {
            transform: translateY(-6px);
            border-color: var(--accent);
            box-shadow: 0 12px 30px rgba(0, 217, 255, .15);
        }

        .card h3 {
            color: var(--accent-soft);
            font-size: 16px;
            margin-bottom: 8px;
        }

        .card p {
            color: var(--ink-dim);
            font-size: 14px;
            margin: 0;
        }

        /* PRICING */
        .price-group-title {
            color: var(--accent-soft);
            font-family: Orbitron;
            font-size: 15px;
            letter-spacing: 1px;
            text-align: center;
            margin: 36px 0 18px;
        }

        .price-group-title:first-of-type {
            margin-top: 0;
        }

        .card.price {
            text-align: center;
        }

        .card.price .amount {
            color: var(--accent);
            font-size: 22px;
            font-family: Orbitron;
            margin-top: 6px;
            display: block;
        }

        /* FORM */
        form {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        input,
        select,
        textarea {
            width: 100%;
            padding: 13px 14px;
            margin-top: 12px;
            background: #0B2230;
            border: 1px solid transparent;
            border-radius: 8px;
            color: var(--ink);
            font-family: Poppins;
            font-size: 14px;
            transition: border-color .2s;
        }

        input:focus,
        select:focus,
        textarea:focus {
            outline: none;
            border-color: var(--accent);
        }

        textarea {
            height: 90px;
            resize: none;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-top: 12px;
        }

        .form-row>div {
            display: flex;
            flex-direction: column;
        }

        .form-row label {
            font-size: 12px;
            color: var(--ink-dim);
            margin-bottom: 4px;
        }

        .form-row input {
            margin-top: 0;
        }

        .price-box {
            padding: 20px;
            margin-top: 20px;
            border-radius: 12px;
            border: 1px solid var(--line);
            background: rgba(0, 217, 255, .04);
        }

        .price-box p {
            display: flex;
            justify-content: space-between;
            margin: 8px 0;
            font-size: 14px;
        }

        .price-box strong {
            color: var(--ink-dim);
            font-weight: 400;
        }

        .price-box hr {
            border: none;
            border-top: 1px solid var(--line);
            margin: 12px 0;
        }

        .price-box .total-row strong {
            color: var(--accent-soft);
        }

        .price-box .total-row span {
            color: var(--accent);
            font-family: Orbitron;
        }

        form .btn {
            margin-top: 20px;
            align-self: flex-start;
        }

        /* DELIVERY INFO (final section) */
        .delivery-info {
            border-top: 1px solid var(--line);
        }

        .delivery-info .cards {
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        }

        .delivery-info .card p {
            margin-top: 6px;
        }

        /* CONTACT */
        .card.contact h3 {
            margin-bottom: 6px;
        }

        /* WHATSAPP FLOAT */
        .whatsapp {
            position: fixed;
            right: 22px;
            bottom: 22px;
            background: var(--accent);
            color: var(--bg);
            padding: 14px 24px;
            border-radius: 40px;
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            z-index: 999;
            box-shadow: 0 6px 20px rgba(0, 217, 255, .35);
        }

        footer {
            padding: 28px;
            text-align: center;
            font-size: 12px;
            color: var(--ink-dim);
            border-top: 1px solid var(--line);
        }

        @media(max-width:700px) {
            nav .links {
                display: none;
            }

            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <nav id="navbar">
        <div class="logo">ICE LAB</div>
        <div class="links">
            <a href="#services">Services</a>
            <a href="#pricing">Pricing</a>
            <a href="#order">Order</a>
            <a href="#contact">Contact</a>
        </div>
    </nav>

    <!-- HERO -->
    <div class="hero">
        <h1>Premium Ice Delivery in Gaborone</h1>
        <p>Fast, reliable ice supply for events, bars, restaurants and bulk orders.</p>
        <div class="stock">ICE AVAILABLE TODAY</div>
        <div class="hero-actions">
            <a class="btn solid" href="#order">Order Now</a>
            <a class="btn" href="https://wa.me/26774531063">WhatsApp Us</a>
        </div>
    </div>

    <!-- SERVICES -->
    <section id="services">
        <h2 class="section-title">Our Services</h2>
        <p class="section-sub">Ice supply built around your business or event</p>
        <div class="cards">
            <div class="card">
                <h3>Event Ice Supply</h3>
                <p>Large-scale ice for weddings, parties and corporate events.</p>
            </div>
            <div class="card">
                <h3>Bar &amp; Club Supply</h3>
                <p>Reliable delivery for bars, lounges and entertainment venues.</p>
            </div>
            <div class="card">
                <h3>Restaurant Supply</h3>
                <p>Consistent ice supply for restaurants and hospitality.</p>
            </div>
            <div class="card">
                <h3>Bulk Orders</h3>
                <p>Large-volume orders for businesses and events.</p>
            </div>
        </div>
    </section>

    <!-- PRICING -->
    <section id="pricing" class="alt">
        <h2 class="section-title">Ice Pricing</h2>
        <p class="section-sub">Prices drop automatically at higher quantities</p>

        <div class="price-group-title">Cube Ice</div>
        <div class="cards">
            <div class="card price">
                <h3>Single Bag</h3><span class="amount">P20</span>
            </div>
            <div class="card price">
                <h3>20+ Bags</h3><span class="amount">P15</span>
            </div>
            <div class="card price">
                <h3>30+ Bags</h3><span class="amount">P12</span>
            </div>
        </div>

        <div class="price-group-title">Block Ice</div>
        <div class="cards">
            <div class="card price">
                <h3>Single Block</h3><span class="amount">P25</span>
            </div>
            <div class="card price">
                <h3>20+ Blocks</h3><span class="amount">P20</span>
            </div>
            <div class="card price">
                <h3>30+ Blocks</h3><span class="amount">P15</span>
            </div>
        </div>
    </section>

    <!-- ORDER FORM -->
    <section id="order">
        <h2 class="section-title">Place Your Order</h2>
        <p class="section-sub">Fill in your details and we'll confirm on WhatsApp</p>

        <form onsubmit="sendOrder(event)">

            <input id="name" placeholder="Full Name" required>
            <input id="phone" placeholder="Phone Number" required>

            <select id="zone" onchange="calcPrice()">
                <option value="gaborone">Within Gaborone</option>
                <option value="outside">Surrounding Areas</option>
            </select>

            <input id="location" placeholder="Delivery Location / Address" required>

            <div class="form-row">
                <div>
                    <label>Delivery Date</label>
                    <input type="date" id="date" required>
                </div>
                <div>
                    <label>Delivery Time</label>
                    <input type="time" id="time" required>
                </div>
            </div>

            <select id="iceType" onchange="calcPrice()">
                <option value="cube">Cube Ice</option>
                <option value="block">Block Ice</option>
            </select>

            <input id="bags" type="number" placeholder="Quantity" oninput="calcPrice()" required>

            <textarea id="notes" placeholder="Special Instructions"></textarea>

            <div class="price-box">
                <p><strong>Ice Price</strong> <span>P<span id="bagPrice">0</span></span></p>
                <p><strong>Delivery Fee</strong> <span id="deliveryFee">P0</span></p>
                <hr>
                <p class="total-row"><strong>Estimated Total</strong> <span>P<span id="total">0</span></span></p>
            </div>

            <button class="btn solid" type="submit">Send Order</button>

        </form>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="alt">
        <h2 class="section-title">Contact Ice Lab</h2>
        <div class="cards">
            <div class="card contact">
                <h3>WhatsApp</h3>
                <p>+267 74 531 063</p>
            </div>
            <div class="card contact">
                <h3>Business Hours</h3>
                <p>Open Daily</p>
            </div>
            <div class="card contact">
                <h3>Location</h3>
                <p>Broadhurst,Gaborone</p>
            </div>
        </div>
    </section>

    <!-- DELIVERY INFORMATION (final section) -->
    <section id="delivery" class="delivery-info">
        <h2 class="section-title">Delivery Information</h2>
        <div class="cards">
            <div class="card">
                <h3>Within Gaborone</h3>
                <p>P50 delivery fee for orders</p>
            </div>
            <div class="card">
                <h3>Surrounding Areas</h3>
                <p>Delivery charges are negotiable depending on location.</p>
            </div>
            <div class="card">
                <h3>Self-Arranged Transport</h3>
                <p>Customers may also arrange InDrive, Yango or other transport at their own expense.</p>
            </div>
        </div>
    </section>

    <a class="whatsapp" href="https://wa.me/26774531063">WhatsApp</a>

    <footer>© 2026 ICELAB (Designed by-Rebaone Lesly Mochabeng). All Rights Reserved.</footer>

    <script>
        /* NAVBAR HIDE ON SCROLL */
        let lastScroll = 0;
        window.addEventListener("scroll", function () {
            let nav = document.getElementById("navbar");
            let currentScroll = window.scrollY;
            if (currentScroll > lastScroll && currentScroll > 100) {
                nav.style.transform = "translateY(-100%)";
            } else {
                nav.style.transform = "translateY(0)";
            }
            lastScroll = currentScroll;
        });

        /* PRICE CALCULATOR */
        function calcPrice() {
            let quantity = parseInt(document.getElementById("bags").value) || 0;
            let type = document.getElementById("iceType").value;
            let zone = document.getElementById("zone").value;
            let pricePerUnit;
            let delivery = 0;

            if (type === "cube") {
                pricePerUnit = 20;
                if (quantity >= 30) pricePerUnit = 12;
                else if (quantity >= 20) pricePerUnit = 15;
            } else {
                pricePerUnit = 25;
                if (quantity >= 30) pricePerUnit = 15;
                else if (quantity >= 20) pricePerUnit = 20;
            }

            let iceTotal = quantity * pricePerUnit;

            if (zone === "gaborone") {
                if (quantity < 15) delivery = 50;
            } else {
                delivery = "Negotiable";
            }

            document.getElementById("bagPrice").innerText = iceTotal;
            document.getElementById("deliveryFee").innerText =
                delivery === "Negotiable" ? "Negotiable" : "P" + delivery;

            if (delivery === "Negotiable") {
                document.getElementById("total").innerText = iceTotal + " + Delivery";
            } else {
                document.getElementById("total").innerText = iceTotal + delivery;
            }
        }

        /* SEND ORDER TO WHATSAPP */
        function sendOrder(e) {
            e.preventDefault();

            let name = document.getElementById("name").value;
            let phone = document.getElementById("phone").value;
            let zone = document.getElementById("zone").value;
            let location = document.getElementById("location").value;
            let date = document.getElementById("date").value;
            let time = document.getElementById("time").value;
            let iceType = document.getElementById("iceType").value;
            let bags = document.getElementById("bags").value;
            let notes = document.getElementById("notes").value;
            let price = document.getElementById("total").innerText;

            let message = `ICE LAB ORDER
Name: ${name}
Phone: ${phone}
Delivery Area: ${zone}
Location: ${location}
Delivery Date: ${date}
Delivery Time: ${time}
Ice Type: ${iceType}
Quantity: ${bags}
Estimated Price: P${price}
Notes: ${notes}`;

            let whatsapp = "https://wa.me/26774531063?text=" + encodeURIComponent(message);
            window.open(whatsapp, "_blank");
        }
    </script>

</body>

</html>
